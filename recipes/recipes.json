    {
      "id": "megans-zuppa-toscana",
      "name": "Megan's zuppa toscana",
      "servings": "6",
      "tags": [
        "Soup"
      ],
      "ingredients": [
        "5 strips bacon (thick-cut)",
        "1 lb Italian sausage (casings removed)",
        "1 medium onion",
        "5 cloves garlic",
        "2 cups chicken broth",
        "4 cups water",
        "4 large red potatoes",
        "1/4 tsp Italian seasoning",
        "1 cup heavy cream",
        "1 small bunch kale",
        "Salt and pepper"
      ],
      "steps": [
        "Cut the bacon into small pieces. Cook it in a pot on medium-high for 5 minutes.",
        "Add the sausage. Cook about 15 minutes until browned and crispy, stirring now and then.",
        "Spoon off most of the fat. Leave a few tablespoons.",
        "Chop the onion and mince the garlic. Stir them in and cook 2 to 3 minutes.",
        "Dice the potatoes with skins on. Add the broth, water, potatoes, and Italian seasoning.",
        "Bring to a boil on high. Turn down to medium-low and simmer 10 to 15 minutes, until the potatoes are tender.",
        "Remove the kale stems and tear the leaves into bite-size pieces.",
        "Stir in the cream and kale. Cook about 5 minutes, until the kale wilts.",
        "Season with salt and pepper."
      ],
      "notes": "Hot Italian sausage or 1/4 tsp red pepper flakes adds heat. Half-and-half works in place of cream. Keeps 3 to 4 days in the fridge.",
      "source": "https://www.saltandlavender.com/sausage-bacon-potato-and-kale-soup/"
    }
  ]
